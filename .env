# 管理员后台登录密钥，生产环境务必修改
ADMIN_SECRET=change-this-admin-secret

# API 写入/修改密钥；不配置时默认复用 ADMIN_SECRET
API_SECRET=change-this-api-secret

# 数据库类型：sqlite 或 mysql
DB_CLIENT=sqlite

# SQLite 配置
SQLITE_PATH=data/customer-submit.sqlite

# MySQL 配置，DB_CLIENT=mysql 时启用
# MYSQL_URL=mysql://user:password@127.0.0.1:3306/customer_submit_system


# WS Cookie 服务配置（lib/ws-cookie-client.js）
WS_COOKIE_HOST=127.0.0.1
WS_COOKIE_PORT=8765
WS_COOKIE_CACHE_FILE=data/cookie_cache.json
