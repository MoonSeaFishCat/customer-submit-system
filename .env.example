# 管理员后台登录密钥，生产环境务必修改
ADMIN_SECRET=change-this-admin-secret

# API 写入/修改密钥会在数据库初始化时随机生成，并在后台「接口文档」中展示。
# 如需重置，可删除数据库 app_meta 表中的 api_key 记录后重启/重新初始化。

# 如果部署在 HTTPS 后面并希望 Cookie 仅通过 HTTPS 发送，设置为 true。
# HTTP、内网或未配置 HTTPS 的 Linux 部署请保持 false，否则登录成功后浏览器可能不会保存 Cookie。
COOKIE_SECURE=false

# 数据库类型：sqlite 或 mysql
DB_CLIENT=sqlite

# SQLite 配置
SQLITE_PATH=data/customer-submit.sqlite

# MySQL 配置，DB_CLIENT=mysql 时启用
# MYSQL_URL=mysql://user:password@127.0.0.1:3306/customer_submit_system
